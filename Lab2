sorterade_kort = []
while not q.isEmpty():
    flyttade_korten = q.dequeue() # poppar värdet av index 0 och flyttar bak.
    q.enqueue(flyttade_korten)

    if not q.isEmpty():
        print(q)
        bordkort = q.dequeue() # tar nu ut första kortet, och sparar i lista på bordet
        sorterade_kort.append(bordkort)
        print (f"{flyttade_korten} flyttas bak, {bordkort} läggs på bordet")

print(sorterade_kort)


